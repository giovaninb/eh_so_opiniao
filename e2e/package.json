{
  "name": "eso-e2e",
  "private": true,
  "version": "1.0.0",
  "description": "Testes de interface do site É Só Opinião? (Playwright + axe-core)",
  "scripts": {
    "preparar-dados": "../.venv/bin/python ../tools/gerar_dados_e2e.py",
    "pretest": "npm run preparar-dados",
    "test": "playwright test --project=chromium-movel --project=webkit-movel --project=firefox-movel --project=chromium-desktop",
    "test:visual": "playwright test --project=visual",
    "visual:atualizar": "playwright test --project=visual --update-snapshots",
    "lighthouse": "node lighthouse.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.50.0",
    "lighthouse": "^12.0.0"
  }
}